{
  "name": "yunicity-frontend",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "postlint": "node scripts/normalize-next-tsconfig.mjs",
    "postbuild": "node scripts/normalize-next-tsconfig.mjs",
    "pretypecheck": "node scripts/normalize-next-tsconfig.mjs",
    "typecheck": "turbo typecheck",
    "validate": "pnpm typecheck && pnpm lint && pnpm build",
    "test": "turbo run test",
    "clean:next": "node scripts/clean-next.mjs",
    "build:web:clean": "node scripts/clean-next.mjs && pnpm --filter web build",
    "build:admin:clean": "node scripts/clean-next.mjs && pnpm --filter admin build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.7",
    "cross-env": "^10.1.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.20",
      "mobile>react": "19.1.0",
      "mobile>react-dom": "19.1.0",
      "expo-linking": "~8.0.12",
      "mobile>@types/react": "~19.1.0",
      "web>@types/react": "18.3.20",
      "admin>@types/react": "18.3.20",
      "@types/react-dom>@types/react": "18.3.20",
      "@xmldom/xmldom": "0.8.15",
      "tar": "7.5.21",
      "shell-quote": ">=1.9.0",
      "postcss": "8.5.18",
      "sharp": "0.35.4",
      "nanoid@3": "3.3.18",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "brace-expansion": "5.0.9",
      "vitest": ">=4.1.0",
      "esbuild": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=6.0.0 <6.2.4": "6.2.4",
      "vitest>vite": "7.3.5",
      "@vitest/mocker>vite": "7.3.5",
      "vite": "7.3.5",
      "undici@<6.27.0": "6.27.0",
      "browserslist": "4.28.7",
      "metro@<0.83.8": "0.83.8",
      "metro-babel-transformer@<0.83.8": "0.83.8",
      "metro-cache@<0.83.8": "0.83.8",
      "metro-cache-key@<0.83.8": "0.83.8",
      "metro-config@<0.83.8": "0.83.8",
      "metro-core@<0.83.8": "0.83.8",
      "metro-file-map@<0.83.8": "0.83.8",
      "metro-minify-terser@<0.83.8": "0.83.8",
      "metro-resolver@<0.83.8": "0.83.8",
      "metro-runtime@<0.83.8": "0.83.8",
      "metro-source-map@<0.83.8": "0.83.8",
      "metro-symbolicate@<0.83.8": "0.83.8",
      "metro-transform-plugins@<0.83.8": "0.83.8",
      "metro-transform-worker@<0.83.8": "0.83.8"
    }
  }
}

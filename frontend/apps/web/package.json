{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "node ../../scripts/normalize-next-tsconfig.mjs",
    "build": "cross-env NEXT_BUILD_DIR=.next-build next build",
    "start": "cross-env NEXT_BUILD_DIR=.next-build next start --port 3000",

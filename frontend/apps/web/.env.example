# Copier vers .env.local — variables publiques uniquement
# Local/QA same-origin : laisser NEXT_PUBLIC_API_URL vide. Le navigateur appelle
# /api/v1/... sur le même hôte que l'app ; Next relaie vers API_PROXY_TARGET.
# Production : URL absolue de l'API publique (jamais un loopback).
NEXT_PUBLIC_API_URL=
# Cible serveur-only du proxy local/QA (jamais NEXT_PUBLIC_*). Loopback 8000/8010 uniquement.
API_PROXY_TARGET=http://127.0.0.1:8010
# URL publique de l'app web (canonical, OG, sitemap, robots)
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3002
# Google Maps JavaScript API — carte /map (FEATURE-MAP-GOOGLE-01)
# Clé publique restreinte (referrer HTTP + Maps JavaScript API).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Cloud Console, type Vector, plateforme JavaScript) — rendu vectoriel + AdvancedMarkerElement (T3).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Mapbox GL — aperçus statiques lieux/événements uniquement (la carte /map utilise Google Maps)
NEXT_PUBLIC_MAPBOX_TOKEN=

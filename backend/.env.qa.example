# Yunicity — QA isolated environment (C3-F0-T1) — EXAMPLE, no secrets.
#
# For running backend/tooling on the HOST against the QA stack. The compose stack
# (docker-compose.qa.yml) sets these inline for the containers; this file mirrors
# them for host-side commands (pytest, python -m app.qa.launcher).
#
# Copy to a location OUTSIDE the repo (e.g. ~/.yunicity/qa.env) before filling in.
# Never commit a real .env.qa.

APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# Sole destructive authority. Host triplet: localhost:5455/yunicity_qa.
TEST_DATABASE_URL=postgresql+asyncpg://yunicity_qa:CHANGE_ME_LOCAL_ONLY@localhost:5455/yunicity_qa
# App-serving URL (same QA DB in QA). Tooling never reads this one.
DATABASE_URL=postgresql+asyncpg://yunicity_qa:CHANGE_ME_LOCAL_ONLY@localhost:5455/yunicity_qa
REDIS_URL=redis://localhost:6399/0

# QA-only secrets (non-production values).
JWT_SECRET_KEY=qa-only-jwt-secret-at-least-32-characters-long!!
REFRESH_TOKEN_PEPPER=qa-only-pepper-32-chars-minimum!!

# External effects neutralized — the anti-production guard refuses anything else.
EMAIL_PROVIDER=console
EXPO_PUSH_ENABLED=false
LOCAL_VIDEO_STORAGE_BACKEND=filesystem
MEDIA_UPLOAD_DIR=/tmp/yunicity-uploads
# Story/post media: filesystem QA only (never R2 keys). Compose mounts a named
# volume yunicity-qa-story-media → /var/yunicity-qa/story-media.
# Wipe: `python -m app.qa.launcher reset` OR `docker compose -p yunicity-qa -f docker-compose.qa.yml down -v`.
STORY_MEDIA_STORAGE_BACKEND=filesystem
STORY_MEDIA_UPLOAD_DIR=/var/yunicity-qa/story-media

# QA run marker — the launcher sets/mints these; shown here for reference only.
# YUNICITY_QA_MODE=1
# YUNICITY_QA_RUN_TOKEN=<generated-by-launcher>

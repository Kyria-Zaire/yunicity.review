# Copy to .env and adjust — never commit .env

APP_NAME=Yunicity API
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# Optional for TICKET-002 local run (health works without these)
DATABASE_URL=postgresql+asyncpg://yunicity:yunicity@localhost:5432/yunicity_dev
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]
LOG_LEVEL=INFO

# DEV ONLY — copier vers .env (gitignoré) : cp backend/.env.example backend/.env
# Interdiction de réutiliser ces valeurs en recette, preprod ou prod.
#
# Noms alignés sur app/core/config.py (Settings) :
# APP_NAME, APP_ENV, DEBUG, API_V1_PREFIX, DATABASE_URL, REDIS_URL, CORS_ORIGINS, LOG_LEVEL
# JWT_SECRET_KEY, JWT_ALGORITHM, ACCESS_TOKEN_EXPIRE_MINUTES, REFRESH_TOKEN_EXPIRE_DAYS
# REFRESH_COOKIE_NAME, REFRESH_COOKIE_SECURE, REFRESH_COOKIE_SAMESITE, REFRESH_TOKEN_PEPPER

APP_NAME=Yunicity API
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# Docker Compose (noms de services postgres / redis)
DATABASE_URL=postgresql+asyncpg://yunicity:yunicity_dev_password@postgres:5432/yunicity_dev
REDIS_URL=redis://redis:6379/0

# API hors Docker (Postgres mappé sur localhost:5434)
# DATABASE_URL=postgresql+asyncpg://yunicity:yunicity_dev_password@localhost:5434/yunicity_dev
# REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:19006"]
LOG_LEVEL=INFO

# Auth (DEV ONLY — ne jamais réutiliser en prod)
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-in-env-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_TOKEN_PEPPER=dev-only-pepper-not-for-production
WEB_FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_HOURS=1

# Email transactionnel (QA-05B) — Resend recommandé pour forgot-password
EMAIL_PROVIDER=none
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=no-reply@yunicity.fr

# Bootstrap SUPER_ADMIN (PLATFORM-AUTH-RECOVERY-01)
# Dev/recette : fallback documenté si variables absentes (admin@yunicity.dev).
# Recette/preprod : définir explicitement les deux variables.
YUNICITY_BOOTSTRAP_ADMIN_EMAIL=admin@yunicity.dev
YUNICITY_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeBootstrap1!Dev
# YUNICITY_BOOTSTRAP_ADMIN_FULL_NAME=Yunicity Bootstrap Admin

# Push Expo (TICKET-307) — en dev : false = log uniquement, pas d'appel réseau
EXPO_PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# Weather provider (WEB-SEARCH-02A)
# Open-Meteo utilisé par défaut (sans clé API)
# OPENWEATHER_API_KEY=  # optionnel legacy, non requis

# Tampons locaux (TICKET-504) — feed désactivé par défaut
PASSPORT_STAMP_FEED_EVENTS=false

# Transit Grand Reims / CITURA (WEB-MAP-02) — import GTFS statique
# Téléchargement : https://transport.data.gouv.fr/datasets/offre-de-transport-du-reseau-grand-reims-mobilites-communaute-urbaine-du-grand-reims
# GRAND_REIMS_GTFS_URL=https://transport.data.gouv.fr/resources/80594/download
# GTFS-RT (optionnel, non utilisé en MVP scheduled)
# GRAND_REIMS_GTFS_RT_URL=
# GRAND_REIMS_GTFS_LOCAL_PATH=data/gtfs/grand-reims.zip

# Abonnements citoyens (WEB-SUBSCRIPTIONS-01) — Stripe Checkout optionnel
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PLUS_MONTHLY=
# STRIPE_PRICE_PLUS_ANNUAL=
# STRIPE_PRICE_PREMIUM_MONTHLY=
# STRIPE_PRICE_PREMIUM_ANNUAL=
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/subscriptions?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/subscriptions?checkout=cancel

# Story media upload (WEB-STORIES-02)
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:8000

# Local Video V2 (FEATURE-CREATORS-V2 / C2-S1)
LOCAL_VIDEO_STORAGE_BACKEND=filesystem
LOCAL_VIDEO_MAX_BYTES=52428800
LOCAL_VIDEO_MAX_DURATION_SECONDS=60
LOCAL_VIDEO_PRESIGNED_TTL_SECONDS=900
# LOCAL_VIDEO_CDN_BASE_URL=https://media.dev.yunicity.fr
# LOCAL_VIDEO_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# LOCAL_VIDEO_R2_ACCESS_KEY_ID=
# LOCAL_VIDEO_R2_SECRET_ACCESS_KEY=
# LOCAL_VIDEO_R2_BUCKET=yunicity-local-video-dev

# Supabase recovery (TICKET-250) — Postgres restauré localement, jamais en prod telle quelle
# SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/postgres

# ---------------------------------------------------------------------------
# PROD / PREPROD — checklist minimale (injecter via gestionnaire de secrets)
# ---------------------------------------------------------------------------
# APP_ENV=prod
# DEBUG=false
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/yunicity_prod
# REDIS_URL=redis://<host>:6379/0
# JWT_SECRET_KEY=<48+ chars aléatoires>
# REFRESH_TOKEN_PEPPER=<32+ chars aléatoires>
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=lax
# CORS_ORIGINS=["https://yunicity.fr","https://admin.yunicity.fr"]
# WEB_FRONTEND_URL=https://yunicity.fr
# MEDIA_PUBLIC_BASE_URL=https://api.yunicity.fr
# LOG_LEVEL=INFO
# YUNICITY_BOOTSTRAP_ADMIN_EMAIL=<ops@domaine>
# YUNICITY_BOOTSTRAP_ADMIN_PASSWORD=<mot de passe fort>
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=<clé Resend>
# EMAIL_FROM=no-reply@yunicity.fr
